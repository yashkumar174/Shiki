{
  "manifest_version": 3,
  "name": "Shiki",
  "version": "1.0.0",
  "description": "Lets Shiki, the cat on your PC, work in your browser when you ask it to. It talks only to Shiki on this computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Shiki",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
