<Window x:Class="ConvertedBro.UI.BuddyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Converted Bro"
        Width="140" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowDrop="True" ToolTip="Drop files on me · right-click for options">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Nearly invisible disc so drops land anywhere around the bro, not only on his pixels. -->
        <Ellipse Width="134" Height="134" Fill="#01000000" />

        <Ellipse x:Name="Glow" Width="128" Height="128" Opacity="0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#B08B7CFF" Offset="0.55" />
                    <GradientStop Color="#008B7CFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="BusyRing" Width="110" Height="110" Opacity="0" IsHitTestVisible="False"
                 Stroke="#B9F5FF" StrokeThickness="3" StrokeDashArray="5 4" StrokeDashCap="Round"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="BusyRotate" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse Width="70" Height="12" VerticalAlignment="Bottom" Margin="0,0,0,16" Fill="#55000000" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="8" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid x:Name="Body" Width="88" Height="88" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodySquash" />
                    <TranslateTransform x:Name="BodyBob" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse>
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                        <GradientStop Color="#A08BFF" Offset="0" />
                        <GradientStop Color="#5B48F2" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="40" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,9,0,0" Fill="#40FFFFFF" />

            <Canvas Width="88" Height="88">
                <!-- Open eyes; blink by squashing this canvas. -->
                <Canvas x:Name="Eyes" Width="88" Height="88" RenderTransformOrigin="0.5,0.45">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="EyesScale" />
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="23" Canvas.Top="28" Width="17" Height="20" Fill="White" />
                    <Ellipse Canvas.Left="48" Canvas.Top="28" Width="17" Height="20" Fill="White" />
                    <Canvas x:Name="Pupils">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="PupilShift" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="28" Canvas.Top="34" Width="9" Height="10" Fill="#1E1B3A" />
                        <Ellipse Canvas.Left="53" Canvas.Top="34" Width="9" Height="10" Fill="#1E1B3A" />
                        <Ellipse Canvas.Left="33" Canvas.Top="35" Width="3" Height="3" Fill="White" />
                        <Ellipse Canvas.Left="58" Canvas.Top="35" Width="3" Height="3" Fill="White" />
                    </Canvas>
                </Canvas>

                <!-- ^ ^ eyes for the happy moment after a conversion. -->
                <Path x:Name="HappyEyes" Opacity="0" Stroke="#1E1B3A" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 24,42 Q 31.5,31 39,42 M 49,42 Q 56.5,31 64,42" />

                <Ellipse Canvas.Left="15" Canvas.Top="50" Width="12" Height="7" Fill="#FF8FB1" Opacity="0.55" />
                <Ellipse Canvas.Left="61" Canvas.Top="50" Width="12" Height="7" Fill="#FF8FB1" Opacity="0.55" />

                <Path x:Name="Smile" Stroke="#1E1B3A" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 35,56 Q 44,65 53,56" />
                <Ellipse x:Name="MouthO" Canvas.Left="38" Canvas.Top="53" Width="12" Height="13" Fill="#1E1B3A" Opacity="0" />
            </Canvas>
        </Grid>

        <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,16,0"
                MinWidth="22" Height="22" CornerRadius="11" Background="#FF5D73" Padding="6,0"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="BadgeText" Foreground="White" FontWeight="Bold" FontSize="12"
                       FontFamily="{StaticResource BroFont}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
