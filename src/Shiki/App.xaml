<Application x:Class="Shiki.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="BroFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="PanelBrush" Color="#F01A1C29" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5FA" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#A3A8BD" />
        <SolidColorBrush x:Key="TrackBrush" Color="#22FFFFFF" />

        <Color x:Key="ImageColor">#FF8A5C</Color>
        <Color x:Key="VideoColor">#6C8BFF</Color>
        <Color x:Key="AudioColor">#3DD6A3</Color>
        <Color x:Key="PdfColor">#FF5D73</Color>

        <Style x:Key="ToastButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BroFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1FFFFFFF" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
